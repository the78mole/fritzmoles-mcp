# FRITZ!Box TR-064 access for fritzmoles-mcp.
# Copy to .env (gitignored) or export these in the environment of the MCP host.
# The user needs the "FRITZ!Box Einstellungen" + "Sprachnachrichten, Faxnachrichten,
# FRITZ!App Fon und Anrufliste" rights; TR-064 must be enabled under
# Heimnetz > Netzwerk > Netzwerkeinstellungen > "Zugriff für Anwendungen zulassen".

FRITZ_HOST=fritz.box
FRITZ_USERNAME=fritz1234
FRITZ_PASSWORD=change-me

# Optional
#FRITZ_PORT=49000          # 49443 when FRITZ_TLS=true (auto-selected if unset)
#FRITZ_TLS=false           # use https for TR-064
#FRITZ_TIMEOUT=10          # seconds per TR-064 request
#FRITZ_READ_ONLY=false     # true = hide every tool that changes box state
#FRITZ_DOWNLOAD_DIR=~/fritz-voicemails   # where download_voicemail stores recordings
